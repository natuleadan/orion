# Environment Variables for Natuleadan Orion (Local & CI Contract)
# Local dev: copy to .env (git-ignored) and populate required values.
# CI/CD: sync required keys via `gh secret set <KEY> --repo natuleadan/orion` (fail-fast if missing).

# [var] Runtime environment (development | staging | production)
ORION_ENV=development
# [var] HTTP/RPC listener port
ORION_PORT=8080
# [secret] Bunny.net master API key
BUNNY_API_KEY=CHANGE_ME
# [secret] Upstash Redis REST endpoint
UPSTASH_REDIS_REST_URL=CHANGE_ME
# [secret] Upstash Redis REST token
UPSTASH_REDIS_REST_TOKEN=CHANGE_ME
# [secret] Better Stack telemetry source token
BETTER_STACK_SOURCE_TOKEN=CHANGE_ME
